# Optional helper for setup.sh. Copy to .env if you like; it is gitignored.
# The bot TOKEN does NOT go here — you paste it into the guided
#   openclaw --profile classdemo channels add --channel telegram
# so it never touches argv, shell history, or this repo. OpenClaw stores it in
# its own protected secret store.

# Your Telegram numeric user id (message @userinfobot to get it).
# Only this id will be served; everyone else is ignored.
OPERATOR_TG_ID=
